<template>
    <div>
        <NotificationBox v-if="blockError" :alertType="AlertType.Warning">{{ blockError }}</NotificationBox>

        <Panel v-else :title="alert.name || (isRealtime ? 'Real-time IIS Rule' : 'IIS Alert Detail')">
            <NotificationBox v-if="errorMessage" :alertType="AlertType.Danger">{{ errorMessage }}</NotificationBox>

            <template v-if="!isEditMode">
                <dl class="dl-horizontal">
                    <dt>Description</dt><dd>{{ alert.description || '' }}</dd>
                    <dt>Type</dt><dd>{{ isRealtime ? 'Real-time request rule' : 'Historical log query' }}</dd>
                    <dt>Active</dt><dd>{{ alert.isActive ? 'Yes' : 'No' }}</dd>
                    <template v-if="isRealtime">
                        <dt>Processing Stage</dt><dd>{{ stageLabel(alert.requestStage) }}</dd>
                        <dt>Condition Logic</dt><dd>{{ alert.conditionLogic === 'Any' ? 'Match any condition (OR)' : 'Match all conditions (AND)' }}</dd>
                        <dt>Conditions</dt>
                        <dd>
                            <ol class="pl-3">
                                <li v-for="(condition, index) in alert.conditions || []" :key="index">
                                    {{ conditionLabel(condition) }}
                                </li>
                            </ol>
                        </dd>
                    </template>
                    <dt>Email Addresses</dt><dd>{{ alert.notificationEmails || '' }}</dd>
                    <dt>{{ isRealtime ? 'Alert Cooldown' : 'Evaluate Every' }}</dt><dd>{{ alert.evaluationFrequencyMinutes }} minute(s)</dd>
                    <dt v-if="isRealtime">Block Current Request</dt><dd v-if="isRealtime">{{ alert.blockRequest ? `${alert.blockResponseStatusCode || 403} ${alert.blockResponseMessage || ''}` : 'No' }}</dd>
                    <dt>Block IP Addresses</dt><dd>{{ alert.blockIpAddress ? `Yes, for ${alert.blockIpAddressMinutes || 60} minute(s)` : 'No' }}</dd>
                    <dt>Lock Out User Accounts</dt><dd>{{ alert.lockOutUserAccounts ? 'Yes' : 'No' }}</dd>
                    <dt>Last Run</dt><dd>{{ alert.lastRunDateTime || 'Never' }}</dd>
                </dl>

                <template v-if="!isRealtime">
                    <h4>Query</h4>
                    <pre class="well well-sm">{{ alert.query }}</pre>
                </template>

                <h4>Summary Lava</h4>
                <pre class="well well-sm">{{ alert.summaryLava }}</pre>

                <RockButton v-if="isEditable" btnType="primary" @click="edit">Edit</RockButton>
            </template>

            <RockForm v-else :formResetKey="formResetKey" @submit="save">
                <TextBox v-model="alert.name" label="Name" rules="required" />
                <TextBox v-model="alert.description" label="Description" textMode="multiline" :rows="3" />
                <CheckBox v-model="alert.isActive" label="Active" />
                <RadioButtonList v-model="alert.evaluationMode"
                                 label="Type"
                                 :items="evaluationModeItems"
                                 horizontal />

                <template v-if="!isRealtime">
                    <h4>Historical Query</h4>
                    <CodeEditor v-model="alert.query" label="SQL Query" help="Use [[logs]] in the FROM clause as the IIS log parquet source." mode="sql" :rows="12" rules="required" />
                    <SlidingDateRangePicker v-model="alert.dateRange" label="Date Range" help="Only parquet files whose filename date stamp falls within this range will be included." previewLocation="Right" />
                </template>

                <template v-else>
                    <h4>Request Processing</h4>
                    <RadioButtonList v-model="alert.requestStage"
                                     label="Processing Stage"
                                     help="Before authentication has no user principal. After authentication runs after Forms authentication for web requests and after Rock API-key, JWT, or OIDC authentication for API requests. End of request also includes response fields, but cannot block the completed current request."
                                     :items="requestStageItems"
                                     horizontal />
                    <DropDownList v-model="alert.conditionLogic"
                                  label="Condition Logic"
                                  validationTitle="Conditions"
                                  :items="conditionLogicItems"
                                  :showBlankItem="false"
                                  :rules="[requireConditions]" />

                    <h4>Conditions</h4>
                    <NotificationBox v-if="!(alert.conditions || []).length" :alertType="AlertType.Info">
                        Add at least one condition. Only fields available at the selected processing stage are shown.
                    </NotificationBox>
                    <NotificationBox v-if="incompatibleConditionMessages.length" :alertType="AlertType.Warning">
                        <div v-for="message in incompatibleConditionMessages" :key="message">{{ message }}</div>
                        Change or remove the highlighted conditions before saving.
                    </NotificationBox>

                    <div v-for="(condition, index) in alert.conditions || []" :key="index" class="well well-sm">
                        <div class="row">
                            <div class="col-md-3">
                                <DropDownList v-model="condition.field"
                                              label="Field"
                                              :items="fieldItemsFor(condition)"
                                              @update:modelValue="onConditionFieldChanged(condition, $event)"
                                              :showBlankItem="false"
                                              :rules="[requireAvailableField]" />
                            </div>
                            <div v-if="condition.field === 'RequestHeader' || condition.field === 'ResponseHeader'" class="col-md-3">
                                <TextBox v-model="condition.headerName" label="Header Name" placeholder="X-Forwarded-For" rules="required" />
                            </div>
                            <div class="col-md-3">
                                <DropDownList v-model="condition.operator"
                                              label="Operator"
                                              :items="operatorItemsFor(condition)"
                                              :showBlankItem="true"
                                              blankValue=""
                                              rules="required" />
                            </div>
                            <div v-if="conditionNeedsValue(condition)" class="col-md-3">
                                <DropDownList v-if="condition.field === 'SecurityRole'"
                                              v-model="condition.value"
                                              label="Security Role"
                                              :items="securityRoleItems"
                                              :showBlankItem="true"
                                              blankValue=""
                                              rules="required" />
                                <TextBox v-else
                                         v-model="condition.value"
                                         :label="condition.operator === 'Regex' ? 'Regular Expression' : 'Value'"
                                         :help="condition.operator === 'Regex' ? 'Regular expressions use a 5 ms timeout and accept inputs up to 16,384 characters. Longer inputs and timed-out matches do not match the condition. Other operators compare the complete input.' : undefined"
                                         :rules="conditionValueRules(condition)" />
                            </div>
                        </div>
                        <CheckBox v-if="conditionUsesTextComparison(condition)"
                                  v-model="condition.ignoreCase"
                                  label="Ignore Case" />
                        <RockButton btnType="danger" @click="removeCondition(index)">Remove Condition</RockButton>
                    </div>

                    <RockButton @click="addCondition">Add Condition</RockButton>

                </template>

                <h4>Summary</h4>
                <CodeEditor v-model="alert.summaryLava"
                            label="Summary Lava"
                            :help="isRealtime ? 'Formats the alert history summary. The Request merge field contains the captured request and response values.' : 'Formats the alert history summary. The results merge field contains the query rows. Lava commands are disabled when this is resolved.'"
                            mode="lava"
                            :rows="8" />

                <h4>Notification</h4>
                <TextBox v-model="alert.notificationEmails" label="Email Addresses" help="Comma-separated list of email addresses to notify when this alert trips." />
                <NumberBox v-model="alert.evaluationFrequencyMinutes"
                           :label="isRealtime ? 'Alert Cooldown Minutes' : 'Evaluate Every Minutes'"
                           :help="isRealtime ? 'History and notifications run once per rule version during this interval; the next notification reports suppressed matches. Every matching request is blocked when enabled. Each distinct IP and account is enforced independently, with retries after failed enforcement.' : undefined"
                           :minimumValue="1"
                           rules="required" />

                <h4>Response Actions</h4>
                <CheckBox v-if="isRealtime && alert.requestStage !== 'EndRequest'"
                          v-model="alert.blockRequest"
                          label="Block Current Request"
                          help="Stops the request before its handler executes and returns the configured response." />
                <template v-if="isRealtime && alert.requestStage !== 'EndRequest' && alert.blockRequest">
                    <NumberBox v-model="alert.blockResponseStatusCode" label="Response Status Code" :minimumValue="400" :maximumValue="599" rules="required" />
                    <TextBox v-model="alert.blockResponseMessage" label="Response Message" textMode="multiline" :rows="3" />
                </template>
                <CheckBox v-model="alert.blockIpAddress"
                          label="Block IP Addresses"
                          :help="isRealtime ? 'Adds the matching request client IP to the existing block list. Subsequent requests are rejected at BeginRequest.' : 'When enabled, the alert query must return a BlockedIpAddress column. The c-ip column is also accepted.'" />
                <NumberBox v-if="alert.blockIpAddress" v-model="alert.blockIpAddressMinutes" label="Block IP for Minutes" :minimumValue="1" rules="required" />
                <CheckBox v-if="!isRealtime || alert.requestStage !== 'PreAuthentication'"
                          v-model="alert.lockOutUserAccounts"
                          label="Lock Out User Accounts"
                          :help="isRealtime ? 'Locks the authenticated username captured by the rule.' : 'When enabled, the alert query must return a UserLoginId, UserName, or cs-username column.'" />

                <div class="actions">
                    <RockButton type="submit" btnType="primary" :disabled="isSaving">Save</RockButton>
                    <RockButton v-if="savedAlert" :disabled="isSaving" @click="cancel">Cancel</RockButton>
                </div>
            </RockForm>
        </Panel>
    </div>
</template>

<script setup lang="ts">
    import { computed, ref, watch } from "vue";
    import CheckBox from "@Obsidian/Controls/checkBox.obs";
    import CodeEditor from "@Obsidian/Controls/codeEditor.obs";
    import DropDownList from "@Obsidian/Controls/dropDownList.obs";
    import NotificationBox from "@Obsidian/Controls/notificationBox.obs";
    import NumberBox from "@Obsidian/Controls/numberBox.obs";
    import Panel from "@Obsidian/Controls/panel.obs";
    import RadioButtonList from "@Obsidian/Controls/radioButtonList.obs";
    import RockButton from "@Obsidian/Controls/rockButton.obs";
    import RockForm from "@Obsidian/Controls/rockForm.obs";
    import SlidingDateRangePicker from "@Obsidian/Controls/slidingDateRangePicker.obs";
    import TextBox from "@Obsidian/Controls/textBox.obs";
    import { ValidationRule } from "@Obsidian/ValidationRules";
    import { AlertType } from "@Obsidian/Enums/Controls/alertType";
    import { useConfigurationValues, useInvokeBlockAction } from "@Obsidian/Utility/block";
    import { ListItemBag } from "@Obsidian/ViewModels/Utility/listItemBag";
    import { IisAlertBag } from "./ViewModels/iisAlertBag";
    import { IisAlertConditionBag } from "./ViewModels/iisAlertConditionBag";
    import { IisAlertsInitializationBag } from "./ViewModels/iisAlertsInitializationBag";

    const config = useConfigurationValues<IisAlertsInitializationBag>();
    const invokeBlockAction = useInvokeBlockAction();
    const alert = ref<IisAlertBag>(config.alert || createNewAlert());
    normalizeAlert();
    const savedAlert = ref<IisAlertBag | null>(alert.value.idKey ? cloneAlert(alert.value) : null);
    const blockError = ref(config.errorMessage ?? "");
    const errorMessage = ref("");
    const formResetKey = ref("0");
    const isEditable = config.isEditable;
    const isEditMode = ref(isEditable && !alert.value.idKey);
    const isSaving = ref(false);
    const alertPageParameter = "IISAlertId";

    const evaluationModeItems: ListItemBag[] = [
        { text: "Historical Log Query", value: "LogQuery" },
        { text: "Real-time Request Rule", value: "RealTimeRule" }
    ];
    const requestStageItems: ListItemBag[] = [
        { text: "Before Authentication", value: "PreAuthentication" },
        { text: "After Authentication", value: "PostAuthentication" },
        { text: "End of Request", value: "EndRequest" }
    ];
    const conditionLogicItems: ListItemBag[] = [
        { text: "All conditions (AND)", value: "All" },
        { text: "Any condition (OR)", value: "Any" }
    ];
    const textOperatorItems: ListItemBag[] = [
        { text: "Equals", value: "Equals" },
        { text: "Does Not Equal", value: "NotEquals" },
        { text: "Contains", value: "Contains" },
        { text: "Starts With", value: "StartsWith" },
        { text: "Ends With", value: "EndsWith" },
        { text: "Regular Expression", value: "Regex" },
        { text: "Exists", value: "Exists" },
        { text: "Does Not Exist", value: "DoesNotExist" },
        { text: "Greater Than", value: "GreaterThan" },
        { text: "Greater Than or Equal", value: "GreaterThanOrEqual" },
        { text: "Less Than", value: "LessThan" },
        { text: "Less Than or Equal", value: "LessThanOrEqual" }
    ];
    const securityRoleOperatorItems: ListItemBag[] = [
        { text: "Is Member Of", value: "IsMemberOf" },
        { text: "Is Not Member Of", value: "IsNotMemberOf" }
    ];
    const preAuthenticationFields: ListItemBag[] = [
        { text: "Client IP", value: "ClientIp" },
        { text: "HTTP Method", value: "HttpMethod" },
        { text: "Host", value: "Host" },
        { text: "Path", value: "Path" },
        { text: "Raw URL", value: "RawUrl" },
        { text: "Query String", value: "QueryString" },
        { text: "User Agent", value: "UserAgent" },
        { text: "Referrer", value: "Referrer" },
        { text: "Request Content Type", value: "RequestContentType" },
        { text: "Request Content Length", value: "RequestContentLength" },
        { text: "Request Header", value: "RequestHeader" }
    ];
    const authenticationFields: ListItemBag[] = [
        { text: "Is Authenticated", value: "IsAuthenticated" },
        { text: "Username", value: "UserName" },
        { text: "Security Role", value: "SecurityRole" }
    ];
    const responseFields: ListItemBag[] = [
        { text: "Response Status Code", value: "ResponseStatusCode" },
        { text: "Response Substatus Code", value: "ResponseSubStatusCode" },
        { text: "Response Content Type", value: "ResponseContentType" },
        { text: "Response Header", value: "ResponseHeader" },
        { text: "Duration Milliseconds", value: "DurationMilliseconds" }
    ];
    const retiredFieldLabels: Record<string, string> = {
        ResponseBytes: "Response Bytes"
    };

    const isRealtime = computed((): boolean => alert.value.evaluationMode === "RealTimeRule");
    const securityRoleItems = config.securityRoles || [];
    const availableFieldItems = computed((): ListItemBag[] => {
        const fields = [...preAuthenticationFields];
        if (alert.value.requestStage !== "PreAuthentication") {
            fields.push(...authenticationFields);
        }
        if (alert.value.requestStage === "EndRequest") {
            fields.push(...responseFields);
        }
        return fields;
    });
    const incompatibleConditionMessages = computed((): string[] => {
        const validFields = new Set(availableFieldItems.value.map(item => item.value));
        return (alert.value.conditions || [])
            .map((condition, index) => !condition.field || validFields.has(condition.field)
                ? ""
                : `Condition ${index + 1} uses ${fieldLabel(condition.field)}, which is unavailable at ${stageLabel(alert.value.requestStage)}.`)
            .filter(message => !!message);
    });

    watch(() => alert.value.evaluationMode, mode => {
        if (mode === "RealTimeRule" && !(alert.value.conditions || []).length) {
            addCondition();
        }
    });

    watch(() => alert.value.requestStage, stage => {
        if (stage === "EndRequest") {
            alert.value.blockRequest = false;
        }
        if (stage === "PreAuthentication") {
            alert.value.lockOutUserAccounts = false;
        }

    });

    function createNewAlert(): IisAlertBag {
        return {
            isActive: true,
            evaluationMode: "LogQuery",
            requestStage: "PreAuthentication",
            conditionLogic: "All",
            conditions: [],
            evaluationFrequencyMinutes: 60,
            dateRange: config.defaultDateRange,
            blockRequest: false,
            blockResponseStatusCode: 403,
            blockIpAddress: false,
            blockIpAddressMinutes: 60,
            lockOutUserAccounts: false
        };
    }

    function normalizeAlert(): void {
        alert.value.evaluationMode ||= "LogQuery";
        alert.value.requestStage ||= "PreAuthentication";
        alert.value.conditionLogic ||= "All";
        alert.value.conditions ||= [];
        alert.value.blockRequest ||= false;
        alert.value.blockResponseStatusCode ||= 403;
    }

    function cloneAlert(value: IisAlertBag): IisAlertBag {
        return JSON.parse(JSON.stringify(value)) as IisAlertBag;
    }

    function addCondition(): void {
        alert.value.conditions ||= [];
        alert.value.conditions.push({ field: "Path", operator: "", value: "", ignoreCase: true });
    }

    function removeCondition(index: number): void {
        alert.value.conditions?.splice(index, 1);
    }

    function conditionNeedsValue(condition: IisAlertConditionBag): boolean {
        return condition.operator !== "Exists" && condition.operator !== "DoesNotExist";
    }

    function requireConditions(): true | string {
        return (alert.value.conditions || []).length > 0 || "must include at least one condition";
    }

    function requireAvailableField(value: unknown): true | string {
        const field = Array.isArray(value) ? value[0] : value;
        if (typeof field !== "string" || !field || availableFieldItems.value.some(item => item.value === field)) {
            return true;
        }

        return `is not available at ${stageLabel(alert.value.requestStage)}`;
    }

    function conditionValueRules(condition: IisAlertConditionBag): ValidationRule[] {
        if (!conditionNeedsValue(condition)) {
            return [];
        }

        const rules: ValidationRule[] = ["required"];
        if (["GreaterThan", "GreaterThanOrEqual", "LessThan", "LessThanOrEqual"].includes(condition.operator || "")) {
            rules.push("number");
        }

        if (condition.operator === "Regex") {
            rules.push((value: unknown): true | string => {
                if (typeof value !== "string" || value === "") {
                    return true;
                }

                try {
                    new RegExp(value);
                    return true;
                }
                catch {
                    return "is not a valid regular expression";
                }
            });
        }

        return rules;
    }

    function operatorItemsFor(condition: IisAlertConditionBag): ListItemBag[] {
        return condition.field === "SecurityRole" ? securityRoleOperatorItems : textOperatorItems;
    }

    function fieldItemsFor(condition: IisAlertConditionBag): ListItemBag[] {
        if (!condition.field || availableFieldItems.value.some(item => item.value === condition.field)) {
            return availableFieldItems.value;
        }

        return [
            ...availableFieldItems.value,
            { text: `${fieldLabel(condition.field)} (Unavailable at this stage)`, value: condition.field }
        ];
    }

    function onConditionFieldChanged(condition: IisAlertConditionBag, value: string | string[]): void {
        condition.field = Array.isArray(value) ? value[0] : value;
        const operators = operatorItemsFor(condition);
        if (!operators.some(item => item.value === condition.operator)) {
            condition.operator = "";
            condition.value = "";
        }
        condition.ignoreCase = condition.field !== "SecurityRole" && condition.ignoreCase;
    }

    function conditionUsesTextComparison(condition: IisAlertConditionBag): boolean {
        return !["Exists", "DoesNotExist", "GreaterThan", "GreaterThanOrEqual", "LessThan", "LessThanOrEqual", "IsMemberOf", "IsNotMemberOf"].includes(condition.operator || "");
    }

    function stageLabel(stage: string | null | undefined): string {
        return requestStageItems.find(item => item.value === stage)?.text || stage || "";
    }

    function fieldLabel(field: string | null | undefined): string {
        return [...preAuthenticationFields, ...authenticationFields, ...responseFields].find(item => item.value === field)?.text
            || retiredFieldLabels[field || ""]
            || field
            || "Field";
    }

    function conditionLabel(condition: IisAlertConditionBag): string {
        const field = fieldLabel(condition.field);
        const target = condition.field === "RequestHeader" || condition.field === "ResponseHeader" ? `${field} (${condition.headerName || "unnamed"})` : field;
        const operator = [...textOperatorItems, ...securityRoleOperatorItems].find(item => item.value === condition.operator)?.text || condition.operator || "operator";
        const value = condition.field === "SecurityRole"
            ? securityRoleItems.find(item => item.value === condition.value)?.text || condition.value || ""
            : condition.value || "";
        return conditionNeedsValue(condition) ? `${target} ${operator} ${value}` : `${target} ${operator}`;
    }

    function edit(): void {
        errorMessage.value = "";
        formResetKey.value = Date.now().toString();
        isEditMode.value = true;
    }

    function cancel(): void {
        if (savedAlert.value) {
            alert.value = cloneAlert(savedAlert.value);
            normalizeAlert();
            errorMessage.value = "";
            isEditMode.value = false;
        }
    }

    async function save(): Promise<void> {
        const isNewAlert = !alert.value.idKey;
        errorMessage.value = "";
        isSaving.value = true;
        const result = await invokeBlockAction<IisAlertBag>("SaveAlert", { bag: alert.value });
        isSaving.value = false;

        if (result.isSuccess && result.data) {
            alert.value = result.data;
            normalizeAlert();
            savedAlert.value = cloneAlert(result.data);
            isEditMode.value = false;

            if (isNewAlert && result.data.idKey) {
                updateUrlForSavedAlert(result.data.idKey);
            }
        }
        else {
            errorMessage.value = result.errorMessage || "Unable to save alert.";
        }
    }

    function updateUrlForSavedAlert(idKey: string): void {
        const url = new URL(window.location.href);

        if (url.searchParams.has(alertPageParameter)) {
            url.searchParams.set(alertPageParameter, idKey);
        }
        else if (!replaceNewAlertPathSegment(url, idKey)) {
            url.searchParams.set(alertPageParameter, idKey);
        }

        window.history.replaceState(window.history.state, "", url.toString());
    }

    function replaceNewAlertPathSegment(url: URL, idKey: string): boolean {
        const segments = url.pathname.split("/");

        for (let i = segments.length - 1; i >= 0; i--) {
            if (decodeURIComponent(segments[i]) === "0") {
                segments[i] = encodeURIComponent(idKey);
                url.pathname = segments.join("/");
                return true;
            }
        }

        return false;
    }
</script>
