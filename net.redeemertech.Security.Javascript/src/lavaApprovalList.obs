<template>
    <div>
        <NotificationBox v-if="errorMessage" :alertType="AlertType.Warning">{{ errorMessage }}</NotificationBox>

        <Grid v-else
               title="Lava Approvals"
               :data="gridDataSource"
               :customActions="gridActions"
               keyField="idKey"
               itemTerm="Lava Script"
               tooltipField="contentPreview"
               stickyHeader
               @selectItem="openApproval">
            <SelectColumn v-if="isEditable" />

            <Column name="contentPreview"
                    title="Preview"
                    sortValue="{{ row.contentPreview }}"
                    filterValue="{{ row.contentPreview }}"
                    quickFilterValue="{{ row.contentPreview }}"
                    :filter="textValueFilter"
                    width="45%">
                <template #format="{ row }">
                    <code class="lava-preview">{{ row.contentPreview }}</code>
                </template>
            </Column>

            <Column name="matchingSourceCount"
                    title="Instances"
                    sortValue="{{ row.matchingSourceSortValue }}"
                    filterValue="{{ row.matchingSourceCount }}"
                    quickFilterValue="{{ row.matchingSourceCount }}"
                    :filter="numberValueFilter"
                    visiblePriority="sm"
                    width="10%">
                <template #format="{ row }">
                    {{ row.matchingSourceCount }}
                </template>
            </Column>

            <TextColumn name="detectedDateTime"
                        title="Detected"
                        field="detectedDateTime"
                        :filter="textValueFilter"
                        visiblePriority="sm"
                        width="10%" />

            <Column name="isPublic"
                    title="Public"
                    sortValue="{{ row.isPublic ? '2' : row.isPublic === false ? '1' : '0' }}"
                    filterValue="{{ row.isPublic ? 'Yes' : row.isPublic === false ? 'No' : 'Unknown' }}"
                    quickFilterValue="{{ row.isPublic ? 'Yes' : row.isPublic === false ? 'No' : 'Unknown' }}"
                    :filter="pickExistingValueFilter"
                    visiblePriority="sm"
                    width="8%">
                <template #format="{ row }">
                    <span v-if="row.isPublic" class="public-status">Public</span>
                    <span v-else-if="row.isPublic === false">No</span>
                    <span v-else class="text-muted">Unknown</span>
                </template>
            </Column>

            <Column name="aiReview"
                    title="AI Review"
                    sortValue="{{ row.aiRiskSortOrder }}"
                    filterValue="{{ row.aiRiskAssessment }}"
                    quickFilterValue="{{ row.aiRiskAssessment }}"
                    field="aiRiskAssessment"
                    :filter="pickExistingValueFilter"
                    visiblePriority="sm"
                    width="10%">
                <template #format="{ row }">
                    <span v-if="row.aiReviewDateTime" class="ai-review-status" :class="`risk-${row.aiRiskAssessment ?? 'unknown'}`">
                        {{ row.aiRiskAssessment || "unknown" }}
                    </span>
                    <span v-else class="text-muted">Not reviewed</span>
                </template>
            </Column>

            <Column name="shortcodeAiReview"
                    title="Shortcode Risk"
                    sortValue="{{ row.shortcodeAiRiskSortOrder }}"
                    filterValue="{{ row.shortcodeAiRiskAssessment }}"
                    quickFilterValue="{{ row.shortcodeAiRiskAssessment }}"
                    field="shortcodeAiRiskAssessment"
                    :filter="pickExistingValueFilter"
                    visiblePriority="sm"
                    width="10%">
                <template #format="{ row }">
                    <span v-if="row.shortcodeAiRiskAssessment" class="ai-review-status" :class="`risk-${row.shortcodeAiRiskAssessment ?? 'unknown'}`">
                        {{ row.shortcodeAiRiskAssessment }}
                    </span>
                </template>
            </Column>

            <Column v-if="isEditable" name="approve" title="Approve" width="5%">
                <template #format="{ row }">
                    <RockButton btnType="primary" @click.stop="approveRow(row.idKey)">Approve</RockButton>
                </template>
            </Column>
        </Grid>

        <Modal v-model="isModalOpen" title="Review Lava Approval" :saveText="isEditable ? 'Approve' : ''" @save="approveSelected">
            <NotificationBox v-if="modalErrorMessage" :alertType="AlertType.Warning">{{ modalErrorMessage }}</NotificationBox>

            <template v-if="selectedSource">
                <dl>
                    <dt>Source</dt>
                    <dd>{{ selectedSource.matchingSourceCount }} place{{ selectedSource.matchingSourceCount === 1 ? "" : "s" }}</dd>
                    <dt>Public</dt>
                    <dd>{{ selectedSource.isPublic ? "Yes" : selectedSource.isPublic === false ? "No" : "Unknown" }}</dd>
                    <dt>Content Hash</dt>
                    <dd><code>{{ selectedContentHash }}</code></dd>
                </dl>

                <NotificationBox v-if="selectedAIRiskAssessment == 'high'" :alertType="AlertType.Danger">
                    <strong>High Risk:</strong>
                    This Lava content has been identified as high risk by AI review or raised because it is public. Exercise caution when approving or using this content.
                </NotificationBox>

                <NotificationBox v-if="selectedAIRiskAssessment == 'urgent'" :alertType="AlertType.Danger">
                    <strong>Urgent Risk:</strong>
                    This Lava content is public and has been raised from high risk by AI review. Exercise caution when approving or using this content.
                </NotificationBox>

                <NotificationBox v-if="selectedAIReviewDetails" :alertType="selectedAIHasConcerns ? AlertType.Warning : AlertType.Info">
                    <strong>AI Review:</strong>
                    {{ selectedAIRiskAssessment || "unknown" }} risk.
                    {{ selectedAIReviewDetails }}
                    <span v-if="selectedAIReviewDateTime">Reviewed {{ selectedAIReviewDateTime }}.</span>
                </NotificationBox>

                <table v-if="selectedSources.length" class="source-table table-striped">
                    <thead>
                        <tr>
                            <th>Location</th>
                            <th>Public</th>
                            <th>Shortcode Risk</th>
                            <th>Detected</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr v-for="source in selectedSources" :key="source.idKey ?? source.source ?? source.rowId">
                            <td>
                                <div>{{ source.source }}</div>
                                <dl v-if="source.entityDetails?.length" class="entity-details">
                                    <template v-for="detail in source.entityDetails" :key="`${detail.label}:${detail.value}:${detail.url}`">
                                        <dt>{{ detail.label }}</dt>
                                        <dd>
                                            <a v-if="detail.url" :href="detail.url" target="_blank" rel="noopener noreferrer">{{ detail.value }}</a>
                                            <span v-else>{{ detail.value }}</span>
                                        </dd>
                                    </template>
                                </dl>
                            </td>
                            <td>
                                <span v-if="source.isPublic" class="public-status">Public</span>
                                <span v-else-if="source.isPublic === false">No</span>
                                <span v-else class="text-muted">Unknown</span>
                            </td>
                            <td>
                                <span v-if="source.shortcodeAiRiskAssessment" class="ai-review-status" :class="`risk-${source.shortcodeAiRiskAssessment ?? 'unknown'}`">
                                    {{ source.shortcodeAiRiskAssessment }}
                                </span>
                            </td>
                            <td>{{ source.detectedDateTime }}</td>
                        </tr>
                    </tbody>
                </table>

                <div class="approval-content">
                    <pre v-if="selectedContent">{{ selectedContent }}</pre>
                    <p v-else class="text-muted">Loading content...</p>
                </div>
            </template>
        </Modal>

        <Modal v-model="isAIReviewProgressOpen" title="AI Review Progress" saveText="">
            <NotificationBox v-if="aiReviewProgressError" :alertType="AlertType.Warning">{{ aiReviewProgressError }}</NotificationBox>

            <div class="ai-review-progress">
                <p>{{ aiReviewProgressMessage }}</p>
                <div class="progress">
                    <div class="progress-bar" role="progressbar" :style="{ width: `${aiReviewProgressPercent}%` }">
                        {{ aiReviewCompletedCount }} / {{ aiReviewTotalCount }}
                    </div>
                </div>

                <p v-if="aiReviewCurrentHash" class="text-muted">
                    Reviewing <code>{{ aiReviewCurrentHash }}</code>
                </p>

                <ul v-if="aiReviewErrors.length" class="ai-review-errors">
                    <li v-for="error in aiReviewErrors" :key="error">{{ error }}</li>
                </ul>
            </div>
        </Modal>
    </div>
</template>

<script setup lang="ts">
    import { computed, onMounted, ref, watch } from "vue";
    import Grid, { Column, SelectColumn, TextColumn, textValueFilter, numberValueFilter, pickExistingValueFilter } from "@Obsidian/Controls/grid";
    import { GridAction, IGridState } from "@Obsidian/Types/Controls/grid";
    import Modal from "@Obsidian/Controls/modal.obs";
    import NotificationBox from "@Obsidian/Controls/notificationBox.obs";
    import RockButton from "@Obsidian/Controls/rockButton.obs";
    import { AlertType } from "@Obsidian/Enums/Controls/alertType";
    import { useConfigurationValues, useInvokeBlockAction, useReloadBlock } from "@Obsidian/Utility/block";
    import { GridDataBag } from "@Obsidian/ViewModels/Core/Grid/gridDataBag";
    import { LavaApprovalBag } from "./ViewModels/lavaApprovalBag";
    import { LavaApprovalContentBag } from "./ViewModels/lavaApprovalContentBag";
    import { LavaApprovalsInitializationBag } from "./ViewModels/lavaApprovalsInitializationBag";

    const aiReviewConcurrency = 10;

    const config = useConfigurationValues<LavaApprovalsInitializationBag>();
    const invokeBlockAction = useInvokeBlockAction();
    const reloadBlock = useReloadBlock();
    const sources = ref(config.sources ?? []);
    const errorMessage = ref(config.errorMessage ?? "");
    const modalErrorMessage = ref("");
    const selectedContent = ref("");
    const selectedContentHash = ref("");
    const selectedSources = ref<LavaApprovalBag[]>([]);
    const selectedSource = ref<LavaApprovalBag | null>(null);
    const selectedAIReviewDetails = ref("");
    const selectedAIRiskAssessment = ref("");
    const selectedAIHasConcerns = ref(false);
    const selectedAIReviewDateTime = ref("");
    const isModalOpen = ref(false);
    const isAIReviewProgressOpen = ref(false);
    const isAIReviewInProgress = ref(false);
    const aiReviewCompletedCount = ref(0);
    const aiReviewTotalCount = ref(0);
    const aiReviewCurrentHash = ref("");
    const aiReviewProgressMessage = ref("");
    const aiReviewProgressError = ref("");
    const aiReviewErrors = ref<string[]>([]);
    const isEditable = config.isEditable;
    const isAIReviewConfigured = config.isAIReviewConfigured;
    const gridDataSource = computed((): Promise<GridDataBag> => Promise.resolve({ rows: sources.value as Record<string, unknown>[] }));
    const aiReviewProgressPercent = computed((): number => {
        if (!aiReviewTotalCount.value) {
            return 0;
        }

        return Math.round((aiReviewCompletedCount.value / aiReviewTotalCount.value) * 100);
    });
    const gridActions = computed((): GridAction[] => {
        if (!isEditable) {
            return [];
        }

        const actions: GridAction[] = [{
            title: "Approve",
            tooltip: "Approve selected Lava content",
            iconCssClass: "ti ti-check",
            handler: approveSelectedRows
        }];

        if (!isAIReviewConfigured) {
            return actions;
        }

        actions.push({
            title: "AI Review",
            tooltip: "Review selected Lava content with AI",
            iconCssClass: "ti ti-sparkles",
            disabled: isAIReviewInProgress.value,
            handler: reviewSelectedWithAI
        });

        return actions;
    });

    onMounted(() => {
        const hash = getUrlHashParameter();
        if (hash) {
            openApproval(hash);
        }
    });

    watch(isModalOpen, isOpen => {
        if (!isOpen) {
            setUrlHashParameter(null);
        }
    });

    function getUrlHashParameter(): string {
        return new URL(window.location.href).searchParams.get("hash") ?? "";
    }

    function setUrlHashParameter(hash: string | null): void {
        const url = new URL(window.location.href);

        if (hash) {
            url.searchParams.set("hash", hash);
        }
        else {
            url.searchParams.delete("hash");
        }

        window.history.replaceState(window.history.state, "", url);
    }

    async function openApproval(idKey: string | null | undefined): Promise<void> {
        const source = sources.value.find(s => s.idKey === idKey) ?? null;
        if (!idKey || !source) {
            return;
        }

        selectedSource.value = source;
        selectedContent.value = "";
        selectedContentHash.value = source.contentHash ?? "";
        selectedSources.value = [];
        selectedAIReviewDetails.value = source.aiReviewDetails ?? "";
        selectedAIRiskAssessment.value = source.aiRiskAssessment ?? "";
        selectedAIHasConcerns.value = source.aiHasVulnerabilityConcerns === true;
        selectedAIReviewDateTime.value = source.aiReviewDateTime ?? "";
        modalErrorMessage.value = "";
        isModalOpen.value = true;
        setUrlHashParameter(source.contentHash ?? idKey);

        const result = await invokeBlockAction("GetSourceContent", { contentHash: source.contentHash });
        if (result.isSuccess && result.data) {
            const data = result.data as LavaApprovalContentBag;
            selectedContent.value = data.content ?? "";
            selectedContentHash.value = data.contentHash ?? selectedContentHash.value;
            selectedSources.value = data.sources ?? [];
            selectedAIReviewDetails.value = data.aiReviewDetails ?? selectedAIReviewDetails.value;
            selectedAIRiskAssessment.value = data.aiRiskAssessment ?? selectedAIRiskAssessment.value;
            selectedAIHasConcerns.value = data.aiHasVulnerabilityConcerns === true;
            selectedAIReviewDateTime.value = data.aiReviewDateTime ?? selectedAIReviewDateTime.value;
        }
        else {
            modalErrorMessage.value = result.errorMessage || "Unable to load Lava content.";
        }
    }

    async function approveSelected(): Promise<void> {
        if (!isEditable || !selectedSource.value?.idKey) {
            return;
        }

        const result = await invokeBlockAction("Approve", { contentHash: selectedContentHash.value, note: "" });
        if (result.isSuccess) {
            reloadBlock();
        }
        else {
            modalErrorMessage.value = result.errorMessage || "Unable to approve Lava content.";
        }
    }

    async function approveRow(idKey: string | null | undefined): Promise<void> {
        const source = sources.value.find(s => s.idKey === idKey);
        if (!isEditable || !source?.contentHash) {
            return;
        }

        const result = await invokeBlockAction("Approve", { contentHash: source.contentHash, note: "" });
        if (result.isSuccess) {
            reloadBlock();
        }
        else {
            errorMessage.value = result.errorMessage || "Unable to approve Lava content.";
        }
    }

    async function approveSelectedRows(grid: IGridState): Promise<void> {
        const contentHashes = grid.selectedKeys.filter((k): k is string => !!k);
        if (!contentHashes.length) {
            errorMessage.value = "Select one or more Lava approval rows before approving.";
            return;
        }

        if (!confirm(`Approve ${contentHashes.length} Lava approval row${contentHashes.length === 1 ? "" : "s"}?`)) {
            return;
        }

        for (const contentHash of contentHashes) {
            const result = await invokeBlockAction("Approve", { contentHash, note: "" });
            if (!result.isSuccess) {
                errorMessage.value = result.errorMessage || "Unable to approve one or more Lava approval rows.";
                return;
            }
        }

        reloadBlock();
    }

    async function reviewSelectedWithAI(grid: IGridState): Promise<void> {
        const contentHashes = grid.selectedKeys.filter((k): k is string => !!k);
        if (!contentHashes.length) {
            errorMessage.value = "Select one or more Lava approval rows before requesting AI review.";
            return;
        }

        isAIReviewInProgress.value = true;
        isAIReviewProgressOpen.value = true;
        aiReviewCompletedCount.value = 0;
        aiReviewTotalCount.value = contentHashes.length;
        aiReviewCurrentHash.value = "";
        aiReviewProgressError.value = "";
        aiReviewErrors.value = [];
        aiReviewProgressMessage.value = "Starting AI review...";

        let nextIndex = 0;
        const workerCount = Math.min(aiReviewConcurrency, contentHashes.length);
        const workers = Array.from({ length: workerCount }, async () => {
            while (nextIndex < contentHashes.length) {
                const contentHash = contentHashes[nextIndex++];
                aiReviewCurrentHash.value = contentHash;
                aiReviewProgressMessage.value = `Reviewing ${aiReviewCompletedCount.value + 1} of ${aiReviewTotalCount.value}...`;

                const result = await invokeBlockAction("ReviewWithAI", { contentHashes: [contentHash] });
                if (!result.isSuccess) {
                    aiReviewErrors.value.push(`${contentHash}: ${result.errorMessage || "Unable to review this content."}`);
                }
                else {
                    const data = result.data as { skippedMessages?: string[] | null; skippedCount?: number | null } | null;
                    if ((data?.skippedCount ?? 0) > 0) {
                        const skippedMessages = data?.skippedMessages?.length
                            ? data.skippedMessages
                            : [`${contentHash}: skipped because the content exceeds the AI review size limit.`];

                        aiReviewErrors.value.push(...skippedMessages);
                    }
                }

                aiReviewCompletedCount.value++;
            }
        });

        try {
            await Promise.all(workers);
        }
        catch (error) {
            aiReviewErrors.value.push(error instanceof Error ? error.message : "An unexpected AI review error occurred.");
        }

        aiReviewCurrentHash.value = "";
        isAIReviewInProgress.value = false;

        if (aiReviewErrors.value.length) {
            aiReviewProgressError.value = `${aiReviewErrors.value.length} review${aiReviewErrors.value.length === 1 ? "" : "s"} failed.`;
            aiReviewProgressMessage.value = "AI review finished with errors. Refreshing results...";
        }
        else {
            aiReviewProgressMessage.value = "AI review complete. Refreshing results...";
        }

        window.setTimeout(() => reloadBlock(), 1000);
    }
</script>

<style scoped>
    .lava-preview {
        display: block;
        max-width: 100%;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .source-table {
        border-collapse: collapse;
        margin-bottom: 16px;
        width: 100%;
    }

    .source-table th,
    .source-table td {
        border-bottom: 1px solid #ddd;
        padding: 8px;
        text-align: left;
        vertical-align: top;
    }

    .approval-content {
        max-height: 60vh;
        overflow: auto;
    }

    .entity-details {
        display: grid;
        gap: 2px 8px;
        grid-template-columns: max-content 1fr;
        margin: 6px 0 0;
    }

    .entity-details dt {
        color: #666;
        font-weight: 600;
        margin: 0;
    }

    .entity-details dd {
        margin: 0;
    }

    .approval-content pre {
        white-space: pre-wrap;
        word-break: break-word;
    }

    .ai-review-status {
        border-radius: 999px;
        display: inline-block;
        font-size: 12px;
        font-weight: 600;
        padding: 2px 8px;
        text-transform: capitalize;
    }

    .risk-low {
        background: #e6f4ea;
        color: #137333;
    }

    .risk-medium,
    .risk-unknown {
        background: #fef7e0;
        color: #b06000;
    }

    .risk-high {
        background: #fce8e6;
        color: #c5221f;
    }

    .risk-urgent,
    .public-status {
        background: #fce8e6;
        border-radius: 999px;
        color: #8b0000;
        display: inline-block;
        font-size: 12px;
        font-weight: 700;
        padding: 2px 8px;
        text-transform: capitalize;
    }

    .ai-review-progress .progress {
        margin-bottom: 12px;
    }

    .ai-review-errors {
        margin-top: 12px;
        max-height: 240px;
        overflow: auto;
    }
</style>
